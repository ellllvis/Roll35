<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Viseur : format 3:4, comme le capteur du téléphone -->
    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="3:4"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/exposureRow"
        app:layout_constraintVertical_bias="0" />

    <!-- Masque du format de cadrage -->
    <fr.elvis.roll35.FrameMaskView
        android:id="@+id/frameMask"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="@id/viewFinder"
        app:layout_constraintEnd_toEndOf="@id/viewFinder"
        app:layout_constraintTop_toTopOf="@id/viewFinder"
        app:layout_constraintBottom_toBottomOf="@id/viewFinder" />

    <!-- Nom de la pellicule active -->
    <TextView
        android:id="@+id/filmName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/pill_dark"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:text="@string/film_none"
        android:textColor="#FFFFFFFF"
        android:textSize="14sp"
        app:layout_constraintTop_toTopOf="@id/viewFinder"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Boutons d'objectif (0,6× / 1× / 3× / 5×…), créés selon le téléphone -->
    <LinearLayout
        android:id="@+id/zoomButtons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:background="@drawable/pill_dark"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="4dp"
        app:layout_constraintBottom_toTopOf="@id/exposureRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/flash"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0"
        android:background="@android:color/white"
        app:layout_constraintStart_toStartOf="@id/viewFinder"
        app:layout_constraintEnd_toEndOf="@id/viewFinder"
        app:layout_constraintTop_toTopOf="@id/viewFinder"
        app:layout_constraintBottom_toBottomOf="@id/viewFinder" />

    <!-- Réglages manuels : ISO et vitesse -->
    <LinearLayout
        android:id="@+id/exposureRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/filmStrip">

        <TextView
            android:id="@+id/isoButton"
            style="@style/SettingPill"
            android:text="@string/iso_auto" />

        <TextView
            android:id="@+id/speedButton"
            style="@style/SettingPill"
            android:layout_marginStart="10dp"
            android:text="@string/speed_auto" />
    </LinearLayout>

    <!-- Valeurs ISO ou vitesse, à la place des pellicules pendant le réglage -->
    <HorizontalScrollView
        android:id="@+id/valueStrip"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scrollbars="none"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/filmStrip"
        app:layout_constraintEnd_toEndOf="@id/filmStrip"
        app:layout_constraintTop_toTopOf="@id/filmStrip"
        app:layout_constraintBottom_toBottomOf="@id/filmStrip">

        <LinearLayout
            android:id="@+id/valueChips"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp" />
    </HorizontalScrollView>

    <!-- Sélecteur de pellicule : bande qui défile horizontalement -->
    <HorizontalScrollView
        android:id="@+id/filmStrip"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingVertical="10dp"
        android:scrollbars="none"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/controls">

        <LinearLayout
            android:id="@+id/filmChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp" />
    </HorizontalScrollView>

    <FrameLayout
        android:id="@+id/controls"
        android:layout_width="0dp"
        android:layout_height="112dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageButton
            android:id="@+id/shutter"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_gravity="center"
            android:background="@drawable/shutter_button"
            android:contentDescription="@string/shutter" />

        <TextView
            android:id="@+id/framingButton"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="40dp"
            android:background="@drawable/round_dark"
            android:contentDescription="@string/framing"
            android:gravity="center"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/switchCamera"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="40dp"
            android:background="@drawable/round_dark"
            android:contentDescription="@string/switch_camera"
            android:src="@drawable/ic_switch_camera" />
    </FrameLayout>

    <!-- Affiché seulement si la permission caméra est refusée -->
    <LinearLayout
        android:id="@+id/permissionPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/permission_needed"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp" />

        <Button
            android:id="@+id/grantPermission"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/grant_permission" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
